# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Django stuff:
*.log
*.pot
*.pyc
*.pyo
*.db
*.sqlite3

# If using PostgreSQL, you might ignore local dumps
*.psql

# Media and static (optional if generated)
media/
staticfiles/
static/

# Ignore the environment
.env
.env.*  # if you use env splitting like .env.dev, .env.prod
venv/
ENV/
env/
.venv/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# MacOS / Linux / Windows
.DS_Store
Thumbs.db

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# celery beat schedule files
celerybeat-schedule
celerybeat.pid

# migrations (optional — only if you don’t want to track them)
# **Not recommended to ignore them in production-ready apps**
# **Uncomment if you're sure**
# */migrations/
# !*/migrations/__init__.py

# VSCode settings
.vscode/

# PyCharm
.idea/

# Other project-specific
*.bak
*.swp
*.tmp

